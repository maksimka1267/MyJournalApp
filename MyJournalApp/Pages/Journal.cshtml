@page
@model MyJournalApp.Pages.JournalModel
@{
    ViewData["Title"] = "Журнал";
    Layout = "_Layout";

    var selectedJournal = Model.Journals.FirstOrDefault(j => j.Id == Model.SelectedJournalId);
    var groupName = "";
    if (selectedJournal != null && Model.GroupNames.TryGetValue(selectedJournal.GroupId, out var gn))
    {
        groupName = gn;
    }
    var subjectName = selectedJournal?.Name ?? "";
    var userById = Model.Users?.ToDictionary(u => u.Id, u => u.FullName ?? "—")
                   ?? new Dictionary<Guid, string>();
}
<style>
    .presence-select.form-select {
        background-image: none !important;
    }

    .presence-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        padding-right: .5rem;
    }

    .table-responsive {
        overflow-x: auto;
        position: relative;
    }

    /* Фіксовані (липкі) колонки */
    .journal-table th.sticky-col,
    .journal-table td.sticky-col {
        position: sticky;
        background: #fff; /* колір тла клітинки */
        z-index: 2; /* над звичайними клітинками */
    }

    /* 1-а колонка: № */
    .journal-table .sticky-1 {
        left: 0;
        z-index: 3; /* поверх другої, якщо накладеться */
    }

    /* 2-а колонка: Прізвище, Ім'я */
    .journal-table .sticky-2 {
        left: 40px; /* дорівнює ширині першої колонки № */
        z-index: 3;
    }

    /* Щоб заголовки лишались читабельними над тлом */
    .journal-table thead th.sticky-col {
        background: #f8f9fa; /* як .table-light */
        z-index: 4;
    }

    .presence-select::-ms-expand {
        display: none;
    }
</style>

<h2>Журнал</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

@if (Model.Role == "Admin")
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addJournalModal">
            ➕ Додати журнал
        </button>

        <form method="post" onsubmit="return confirm('Згенерувати журнали з розкладу?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="handler" value="GenerateJournals" />
            <button class="btn btn-outline-primary">⚙️ Згенерувати журнали з розкладу</button>
        </form>

        <form method="post" onsubmit="return confirm('Усі журнали та оцінки будуть видалені. Продовжити?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="handler" value="DeleteAllJournals" />
            <button class="btn btn-danger">🗑 Видалити всі журнали</button>
        </form>
    </div>
}
@if (Model.Role == "Student")
{
    <form method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="handler" value="DownloadIndividualPlan" />
        <button type="submit" class="btn btn-outline-success">
            📒 Індивідуальний план
        </button>
    </form>
}

@if (Model.Role == "Teacher" || Model.Role == "Admin")
{
    <div class="d-flex align-items-start gap-2 mb-4">
        <form method="get">
            <div class="input-group">
                <select name="selectedJournalId" class="form-select" onchange="this.form.submit()">
                    @foreach (var j in Model.Journals
                                    .OrderBy(j => j.Name ?? j.Name ?? "")
                                    .ThenBy(j => Model.GroupNames.GetValueOrDefault(j.GroupId, ""))
                                    .ThenBy(j => j.Date))
                    {
                        var group = Model.GroupNames.GetValueOrDefault(j.GroupId, "Група");
                        var subject = j.Name ?? "Предмет";
                        var text = !string.IsNullOrWhiteSpace(j.Name)
                        ? j.Name
                        : $"{subject} — {group} ({j.Date:yyyy-MM-dd})";

                        <option value="@j.Id" @(j.Id == Model.SelectedJournalId ? "selected" : "")>
                            @text
                        </option>
                    }
                </select>
            </div>
        </form>
        <button class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#exportStudentGradesModal">
            ⬇️ Витягнути оцінки
        </button>
        @* Кнопка «Додати колонку» сверху *@
        @if ((Model.Role == "Teacher") && selectedJournal != null && !Model.IsCuratorOnlyForSelectedJournal)
        {
            <button class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addSpecialGradesModal">
                ➕ Додати колонку
            </button>
        }

        @if (Model.Role == "Admin")
        {
            <form method="post" onsubmit="return confirm('Видалити цей журнал?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="DeleteJournal" />
                <input type="hidden" name="id" value="@Model.SelectedJournalId" />
                <button type="submit" class="btn btn-outline-danger">🗑 Видалити журнал</button>
            </form>
        }
    </div>
}

@if (selectedJournal != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h4>@subjectName</h4>

            @if (Model.Role == "Admin")
            {
                var teacherIds = selectedJournal?.TeacherId ?? new List<Guid>();
                var teacherNamesForJournal = teacherIds
                .Select(id =>
                userById.TryGetValue(id, out var n1) ? n1 :
                (Model.TeacherNames.TryGetValue(id, out var n2) ? n2 : "—"))
                .Distinct()
                .ToList();

                var headerTeacherText = teacherNamesForJournal.Count > 0
                ? string.Join(", ", teacherNamesForJournal)
                : "—";

                <div class="text-muted mb-2">
                    Викладач: <strong>@headerTeacherText</strong>
                </div>
            }
            @if (Model.Role == "Student")
            {
                var studentId = Model.UserId;

                // шапка — единый пул дат по всем оценкам студента
                var allDates = Model.Grades
                .Where(g => g.StudentId == studentId)
                .Select(g => g.Created.Date)
                .Distinct()
                .OrderBy(d => d)
                .ToList();

                <table class="table table-bordered mt-4">
                    <thead class="table-light">
                        <tr>
                            <th>Предмет</th>
                            @foreach (var date in allDates)
                            {
                                <th>@date.ToString("dd.MM.yyyy")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var journal in Model.Journals)
                        {
                            var subject = journal.Name ?? "";
                            // все оценки ЭТОГО студента по ЭТОМУ журналу
                            var studentGradesThisJournal = Model.Grades
                            .Where(g => g.JournalEntryId == journal.Id && g.StudentId == studentId)
                            .ToList();

                            <tr>
                                <td>@subject</td>

                                @foreach (var date in allDates)
                                {
                                    // кандидаты за КОНКРЕТНУЮ дату и КОНКРЕТНЫЙ журнал
                                    var candidates = studentGradesThisJournal
                                    .Where(g => g.Created.Date == date)
                                    .ToList();

                                    // 1) пробуем взять запись с ненулевой оценкой (значимая оценка)
                                    var graded = candidates
                                    .Where(g => (g.Value ?? 0) > 0)     // если Value int?, оставь как есть; если int, замени на g.Value > 0
                                    .OrderByDescending(g => g.Value ?? 0)
                                    .ThenBy(g => g.Created)
                                    .FirstOrDefault();

                                    // 2) если нет — просто возьмём первую (для тултипа/инфы), но выводить число не будем
                                    var any = graded ?? candidates.OrderBy(g => g.Created).FirstOrDefault();

                                    if (graded != null)
                                    {
                                        <td title="Тип: @graded.Comment, Вчитель: @(userById.GetValueOrDefault(graded.TeacherId, "—"))" style="cursor: help;">
                                            @graded.Value
                                        </td>
                                    }
                                    else if (any != null)
                                    {
                                        // есть запись (например, только присутствие), но оценки нет — ставим «–»
                                        <td title="Тип: @any.Comment, Вчитель: @(userById.GetValueOrDefault(any.TeacherId, "—"))" style="cursor: help;">–</td>
                                    }
                                    else
                                    {
                                        // вообще нет записей по этому предмету в эту дату
                                        <td>–</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (Model.Role == "Teacher" || Model.Role == "Admin")
            {
                <div class="small text-muted mb-2">
                    <span class="me-3"><strong>0</strong> — неатестований</span>
                    <span class="me-3"><strong>П</strong> — присутній</span>
                    <span class="me-3"><strong>Н</strong> — відсутній</span>
                </div>

                @* Скрытые формы вне основной формы *@
                <form id="createColForm" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="handler" value="CreateColumn" />
                    <input type="hidden" name="SelectedJournalId" value="@Model.SelectedJournalId" />
                </form>
                <form id="deleteColForm" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="handler" value="DeleteColumn" />
                    <input type="hidden" name="JournalId" value="@Model.SelectedJournalId" />
                    <input type="hidden" name="DateKey" id="del_DateKey" />
                    <input type="hidden" name="TopicKey" id="del_TopicKey" />
                </form>

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="handler" value="UpdateGrades" />
                    <input type="hidden" name="GradesForUpdate.JournalId" value="@Model.SelectedJournalId" />

                    @if (Model.Role == "Teacher" && !Model.IsCuratorOnlyForSelectedJournal)
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <button type="submit" class="btn btn-success">💾 Зберегти всі зміни</button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-bordered mt-3 journal-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="sticky-col sticky-1" style="width: 40px;">№</th>
                                    <th class="sticky-col sticky-2" style="min-width: 200px;">Прізвище, Ім'я</th>
                                    @* ПЕРВАЯ служебная колонка: создать новую *@
                                    <th class="align-top" style="min-width:220px;">
                                        <div class="fw-semibold mb-1">Створити колонку</div>
                                        <div class="d-flex flex-column gap-1">
                                            <input type="date"
                                                   class="form-control form-control-sm"
                                                   name="NewColumn.Date"
                                                   form="createColForm"
                                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                   @(Model.Role == "Teacher" && Model.IsCuratorOnlyForSelectedJournal ? "disabled" : "") />
                                            <select class="form-select form-select-sm"
                                                    name="NewColumn.Topic"
                                                    form="createColForm"
                                                    @(Model.Role == "Teacher" && Model.IsCuratorOnlyForSelectedJournal ? "disabled" : "")>
                                                <option value="">— Тема —</option>
                                                <option value="Лекція">Лекція</option>
                                                <option value="Практична робота">Практична робота</option>
                                                <option value="Лабораторна робота">Лабораторна робота</option>
                                                <option value="Напам'ять">Напам'ять</option>
                                                <option value="Зошит/Конспект">Зошит/Конспект</option>
                                                <option value="Семінарське заняття">Семінарське заняття</option>
                                                <option value="Робота на уроці">Робота на уроці</option>
                                            </select>
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary"
                                                    form="createColForm"
                                                    @(Model.Role == "Teacher" && Model.IsCuratorOnlyForSelectedJournal ? "disabled" : "")>
                                                Створити
                                            </button>
                                        </div>
                                    </th>

                                    @* ДАЛЕЕ — существующие колонки (могут быть несколько на одну дату) *@
                                    @foreach (var column in Model.JournalColumns)
                                    {
                                        var dateKey = column.Date.ToString("yyyyMMdd");
                                        var topicKey = MyJournalApp.Pages.JournalColumn.MakeTopicKey(column.Topic);

                                        <th class="text-center align-top">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div class="text-start">
                                                    <div class="fw-semibold">
                                                        @(!string.IsNullOrWhiteSpace(column.Topic) ? column.Topic : "—")
                                                    </div>
                                                    <small class="text-muted d-block">@column.Date.ToString("dd.MM")</small>
                                                </div>

                                                @* Кнопка удаления — НЕ form, чтобы не вкладывать формы *@
                                                @if ((Model.Role == "Admin") || (Model.Role == "Teacher" && !Model.IsCuratorOnlyForSelectedJournal))
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger btn-delete-col"
                                                            title="Видалити колонку"
                                                            data-datekey="@dateKey"
                                                            data-topickey="@topicKey">
                                                        🗑
                                                    </button>
                                                }
                                            </div>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var index = 1;
                                }
                                @foreach (var student in Model.Students.OrderBy(s => Model.StudentNames.GetValueOrDefault(s.Id, "—")))
                                {
                                    var fullName = Model.StudentNames.GetValueOrDefault(student.Id, "—");
                                    <tr>
                                        <td class="text-center sticky-col sticky-1">@index</td>
                                        <td class="sticky-col sticky-2">@fullName</td>

                                        @* Пустая ячейка под служебную колонку "Создать" *@
                                        <td class="text-center text-muted">—</td>

                                        @foreach (var column in Model.JournalColumns)
                                        {
                                            var dateKey = column.Date.ToString("yyyyMMdd");
                                            var topicKey = MyJournalApp.Pages.JournalColumn.MakeTopicKey(column.Topic);

                                            var grade = Model.Grades.FirstOrDefault(g =>
                                            g.StudentId == student.Id &&
                                            g.Created.Date == column.Date.Date &&
                                            MyJournalApp.Pages.JournalColumn.MakeTopicKey(g.Comment) == topicKey);

                                            var isOwner = selectedJournal?.TeacherId?.Contains(Model.UserId) == true;
                                            bool isReadOnly = Model.Role == "Teacher" &&
                                            !isOwner &&
                                            grade != null &&
                                            grade.TeacherId != Model.UserId;

                                            var inputName = $"GradesForUpdate.Grades[{student.Id}-{dateKey}-{topicKey}]";
                                            var presenceInputName = $"GradesForUpdate.Presence[{student.Id}-{dateKey}-{topicKey}]";

                                            var initialVal = grade?.Value;
                                            var initialStr = initialVal.HasValue ? initialVal.Value.ToString() : "";

                                            string initialPresence = grade?.IsPresent.HasValue == true
                                            ? (grade.IsPresent.Value ? "true" : "false")
                                            : "";

                                            <td class="text-center">
                                                <div class="d-flex flex-column gap-1" data-datekey="@dateKey">
                                                    <input type="number"
                                                           class="form-control form-control-sm text-center grade-input"
                                                           data-name="@inputName"
                                                           data-initial="@initialStr"
                                                           value="@initialStr"
                                                           min="0" max="@selectedJournal.MaxValue"
                                                           title="Вчитель: @(grade != null ? userById.GetValueOrDefault(grade.TeacherId, "Невідомо") : "—")"
                                                           @((Model.IsCuratorOnlyForSelectedJournal || isReadOnly || Model.Role == "Admin") ? "readonly" : "") />

                                                    <select class="form-select form-select-sm presence-select text-center"
                                                            data-name="@presenceInputName"
                                                            data-initial="@initialPresence"
                                                            @((Model.IsCuratorOnlyForSelectedJournal || isReadOnly || Model.Role == "Admin") ? "disabled" : "")>
                                                        <option value="" @(initialPresence == "" ? "selected" : "")></option>
                                                        <option value="true" @(initialPresence == "true" ? "selected" : "")>П</option>
                                                        <option value="false" @(initialPresence == "false" ? "selected" : "")>Н</option>
                                                    </select>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Role == "Teacher" && !Model.IsCuratorOnlyForSelectedJournal)
                    {
                        <div class="mt-3 d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">💾 Зберегти всі зміни</button>
                        </div>
                    }
                </form>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info mt-3">Оберіть журнал для перегляду.</div>
}

<!-- Модалка створення журналу -->
<div class="modal fade" id="addJournalModal" tabindex="-1" aria-labelledby="addJournalModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="CreateJournal" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Назва журналу</label>
                        <input type="text" name="NewJournal.Name" class="form-control"
                               placeholder="Напр.: Вища математика — КБ-21 — І семестр" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Максимальна оцінка</label>
                        <input type="number" name="NewJournal.MaxValue" class="form-control"
                               step="1" min="5" max="12" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Предмет</label>
                        <input type="text" name="NewJournal.Subject" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Група</label>
                        <select name="NewJournal.GroupId" class="form-select" required>
                            <option value="">-- Оберіть групу --</option>
                            @foreach (var kvp in Model.GroupNames.OrderBy(g => g.Value))
                            {
                                <option value="@kvp.Key">@kvp.Value</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Викладач</label>
                        <select name="NewJournal.TeacherId" class="form-select" required>
                            @foreach (var teacher in Model.Teachers)
                            {
                                var name = Model.TeacherNames.GetValueOrDefault(teacher.Id, "Невідомий");
                                <option value="@teacher.Id">@name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Додати</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Модалка витягу оцінок студента -->
<div class="modal fade" id="exportStudentGradesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="ExportStudentGrades" />
                <div class="modal-header">
                    <h5 class="modal-title">Рапортичка оцінок студента</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Студент</label>
                        <select name="ExportGrades.StudentId" class="form-select" required>
                            @foreach (var s in Model.Students.OrderBy(x => Model.StudentNames.GetValueOrDefault(x.Id, "—")))
                            {
                                <option value="@s.Id">@Model.StudentNames.GetValueOrDefault(s.Id, "—")</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label class="form-label">Початок</label>
                            <input type="date" name="ExportGrades.StartDate" class="form-control" value="@DateTime.Today.AddDays(-14).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col">
                            <label class="form-label">Кінець</label>
                            <input type="date" name="ExportGrades.EndDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Завантажити Excel</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Модалка тематичної/підсумкової колонки -->
<div class="modal fade" id="addSpecialGradesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="AddSpecialGrades" />
                <input type="hidden" name="GradesForUpdate.JournalId" value="@Model.SelectedJournalId" />
                <div class="modal-header">
                    <h5 class="modal-title">Додати тематичну/підсумкову колонку</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Тема</label>
                            <select name="GradesForUpdate.Comment" class="form-select" required>
                                <option value="">-- Оберіть тему --</option>
                                <option value="Тематична">Тематична</option>
                                <option value="Рубіжний контроль">Рубіжний контроль</option>
                                <option value="Комплексна контрольна робота">Комплексна контрольна робота</option>
                                <option value="Залік">Залік</option>
                                <option value="Іспит">Іспит</option>
                                <option value="Семестрова">Семестрова</option>
                                <option value="Річна">Річна</option>
                                <option value="Підсумкова">Підсумкова</option>
                                <option value="Захист КП/КР">Захист КП/КР</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Дата</label>
                            <input type="date" name="GradesForUpdate.Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <hr />
                    <h6>Оцінки студентів</h6>
                    <div style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm">
                            @foreach (var student in Model.Students.OrderBy(s => Model.StudentNames.GetValueOrDefault(s.Id)))
                            {
                                <tr>
                                    <td>@Model.StudentNames.GetValueOrDefault(student.Id, "—")</td>
                                    <td style="width: 120px;">
                                        <input type="number" name="GradesForUpdate.Grades[@student.Id]" class="grade-modal-input" min="1" max="12" />
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    @if (Model.Role == "Teacher" && !Model.IsCuratorOnlyForSelectedJournal)
                    {
                        <button type="submit" class="btn btn-primary">Зберегти колонку</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Существующая логика "отправлять только изменённые" — оставляем
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function () {
                form.querySelectorAll('.grade-input').forEach(function (inp) {
                    const initial = (inp.dataset.initial ?? '').trim();
                    const current = (inp.value ?? '').trim();
                    const n = inp.dataset.name;

                    if (inp.hasAttribute('readonly')) {
                        inp.removeAttribute('name');
                        return;
                    }
                    if (current === '') {
                        if (initial === '') {
                            inp.removeAttribute('name');
                        } else {
                            inp.setAttribute('name', n);
                        }
                    } else {
                        if (current === initial) {
                            inp.removeAttribute('name');
                        } else {
                            inp.setAttribute('name', n);
                        }
                    }
                });

                form.querySelectorAll('.presence-select').forEach(function (sel) {
                    const initial = (sel.dataset.initial ?? '').trim();
                    const current = (sel.value ?? '').trim();
                    const n = sel.dataset.name;

                    if (sel.hasAttribute('disabled')) {
                        sel.removeAttribute('name');
                        return;
                    }
                    if (current === initial) {
                        sel.removeAttribute('name');
                    } else {
                        sel.setAttribute('name', n);
                    }
                });
            });
        });

        // Обработчик удаления колонки через скрытую форму
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-delete-col');
            if (!btn) return;

            if (!confirm('Видалити цю колонку? Усі оцінки в ній буде видалено.')) return;

            const dateKey = btn.getAttribute('data-datekey');
            const topicKey = btn.getAttribute('data-topickey');

            const dateInput = document.getElementById('del_DateKey');
            const topicInput = document.getElementById('del_TopicKey');
            const form = document.getElementById('deleteColForm');

            if (dateInput && topicInput && form) {
                dateInput.value = dateKey || '';
                topicInput.value = topicKey || '';
                form.submit();
            }
        });
    });
</script>
