                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                    <button type="submit" class="btn btn-primary">Показати</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // =========================
        // Валидация оценок:
        // разрешено: пусто, 0..regularMax, ИЛИ 30
        // =========================
        function validateGradeInput(inp) {
            // если readonly — не валидируем
            if (inp.hasAttribute('readonly')) {
                inp.setCustomValidity('');
                return true;
            }

            const regMaxRaw = inp.dataset.regularMax;
            const regMax = Number.isFinite(parseInt(regMaxRaw, 10)) ? parseInt(regMaxRaw, 10) : 12;

            const raw = (inp.value ?? '').trim();

            // пустое значение допустимо
            if (raw === '') {
                inp.setCustomValidity('');
                return true;
            }

            const val = Number(raw);
            if (!Number.isFinite(val)) {
                inp.setCustomValidity('Некоректне значення');
                return false;
            }

            // исключение
            if (val === 30) {
                inp.setCustomValidity('');
                return true;
            }

            // обычный диапазон
            if (val < 0 || val > regMax) {
                inp.setCustomValidity(`Допустимо 0–${regMax} або 30`);
                return false;
            }

            inp.setCustomValidity('');
            return true;
        }

        // Живая валидация при вводе
        document.querySelectorAll('.grade-input').forEach(function (inp) {
            inp.addEventListener('input', function () { validateGradeInput(inp); });
            inp.addEventListener('blur', function () { validateGradeInput(inp); });
        });

        // =========================
        // Существующая логика "отправлять только изменённые"
        // + блокирующая валидация перед submit
        // =========================
        document.querySelectorAll('form').forEach(function (form) {
            form.addEventListener('submit', function (e) {

                // 1) Валидация оценок перед отправкой
                const gradeInputs = form.querySelectorAll('.grade-input');
                for (const inp of gradeInputs) {
                    if (inp.hasAttribute('readonly')) continue;

                    if (!validateGradeInput(inp)) {
                        inp.reportValidity();
                        e.preventDefault();
                        return;
                    }
                }

                // 2) Твоя логика выбора name для grade-input
                form.querySelectorAll('.grade-input').forEach(function (inp) {
                    const initial = (inp.dataset.initial ?? '').trim();
                    const current = (inp.value ?? '').trim();
                    const n = inp.dataset.name;

                    if (inp.hasAttribute('readonly')) {
                        inp.removeAttribute('name');
                        return;
                    }

                    // ВСЕГДА шлём 0, даже если он совпадает с initial
                    if (current === '0') {
                        inp.setAttribute('name', n);
                        return;
                    }

                    if (current === '') {
                        if (initial === '') {
                            inp.removeAttribute('name');
                        } else {
                            // было что-то → стало пусто → шлём, чтобы бек понял "стереть"
                            inp.setAttribute('name', n);
                        }
                    } else {
                        // другие значения — только если реально изменились
                        if (current === initial) {
                            inp.removeAttribute('name');
                        } else {
                            inp.setAttribute('name', n);
                        }
                    }
                });

                // 3) Твоя логика выбора name для presence-select
                form.querySelectorAll('.presence-select').forEach(function (sel) {
                    const initial = (sel.dataset.initial ?? '').trim();
                    const current = (sel.value ?? '').trim();
                    const n = sel.dataset.name;

                    if (sel.hasAttribute('disabled')) {
                        sel.removeAttribute('name');
                        return;
                    }

                    if (current === initial) {
                        sel.removeAttribute('name');
                    } else {
                        sel.setAttribute('name', n);
                    }
                });
            });
        });

        // =========================
        // Обработчик удаления колонки через скрытую форму
        // =========================
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-delete-col');
            if (!btn) return;

            if (!confirm('Видалити цю колонку? Усі оцінки в ній буде видалено.')) return;

            const dateKey = btn.getAttribute('data-datekey');
            const topicKey = btn.getAttribute('data-topickey');

            const dateInput = document.getElementById('del_DateKey');
            const topicInput = document.getElementById('del_TopicKey');
            const form = document.getElementById('deleteColForm');

            if (dateInput && topicInput && form) {
                dateInput.value = dateKey || '';
                topicInput.value = topicKey || '';
                form.submit();
            }
        });
        const bottom = document.querySelector('.journal-scroll-bottom');
        const top = document.querySelector('.journal-scroll-top');
        const topInner = document.querySelector('.journal-scroll-top-inner');

        function syncTopWidth() {
            if (!bottom || !top || !topInner) return;

            // ширина контента таблицы
            const table = bottom.querySelector('table');
            if (!table) return;

            // задаём "виртуальную" ширину верхнему скроллу
            topInner.style.width = table.scrollWidth + 'px';
        }

        if (bottom && top) {
            // первичная установка ширины
            syncTopWidth();

            // синхрон прокрутки
            let lock = false;

            top.addEventListener('scroll', () => {
                if (lock) return;
                lock = true;
                bottom.scrollLeft = top.scrollLeft;
                lock = false;
            });

            bottom.addEventListener('scroll', () => {
                if (lock) return;
                lock = true;
                top.scrollLeft = bottom.scrollLeft;
                lock = false;
            });

            // пересчёт при ресайзе
            window.addEventListener('resize', syncTopWidth);

            // если таблица меняет ширину из-за данных
            // (на всякий случай)
            setTimeout(syncTopWidth, 0);
            setTimeout(syncTopWidth, 100);
        }
                    const onlyOneGroup = document.getElementById("onlyOneGroup");
    const groupSelectBlock = document.getElementById("groupSelectBlock");

    if (onlyOneGroup && groupSelectBlock) {

        function toggleGroupBlock() {
            groupSelectBlock.style.display =
                onlyOneGroup.checked ? "block" : "none";
        }

        // при открытии страницы
        toggleGroupBlock();

        // при изменении галочки
        onlyOneGroup.addEventListener("change", toggleGroupBlock);
    }
    });
</script>
