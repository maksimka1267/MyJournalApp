<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Електронний журнал</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #fff;
            border-right: 1px solid #dee2e6;
            padding: 1rem;
            width: 240px;
        }

            .sidebar .nav-link {
                color: #212529;
                font-weight: 500;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background-color: #f1f1f1;
                    border-radius: 6px;
                }

        .main-content {
            margin-left: 240px;
            padding: 1.5rem;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
            margin-bottom: 1rem;
            border-bottom: 1px solid #dee2e6;
        }

            .topbar h5 {
                margin: 0;
                font-weight: 600;
            }

        footer {
            text-align: center;
            margin-top: 2rem;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
            color: #6c757d;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <h5 class="mb-4">Навігація</h5>
        <ul class="nav flex-column">
            <li class="nav-item"><a class="nav-link" href="/">🏠 Головна</a></li>
            <li class="nav-item"><a class="nav-link" href="/Journal">📘 Журнал</a></li>
            <li class="nav-item"><a class="nav-link" href="/Calendar">📅 Календар</a></li>
            <li class="nav-item"><a class="nav-link" href="/Students">👥 Студенти</a></li>
            <li class="nav-item"><a class="nav-link" href="/Groups">🏫 Групи</a></li>

            <li class="nav-item"><a class="nav-link" href="/Profile">👤 Профіль</a></li> <!-- 🔥 Додано -->
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item"><a class="nav-link" href="/Users">🛠 Користувачі</a></li>
            }

            <li class="nav-item mt-2">
                <form method="post" action="/api/Auth/logout">
                    <button type="submit" class="btn btn-link nav-link text-danger p-0">🚪 Вихід</button>
                </form>
            </li>
        </ul>

    </div>

    <div class="main-content">
        <div class="topbar">
            <h5>Електронний журнал</h5>
            <div>
                <span>Користувач: <strong>@User.Identity?.Name</strong></span><br />
                <small>Роль: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
            </div>
        </div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        &copy; 2025 - Запорізький будівельний фаховий коледж
    </footer>

    @RenderSection("Scripts", required: false)
</body>
</html>

