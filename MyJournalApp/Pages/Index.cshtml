@page
@model MyJournalApp.Pages.IndexModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Розклад";
    var isAdmin = Model.Role == "Admin";
    var isTeacher = Model.Role == "Teacher";
    var isStudent = Model.Role == "Student";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var selectedDateTime = Model.SelectedDate.ToDateTime(TimeOnly.FromDateTime(DateTime.Now));
    var ukCulture = new CultureInfo("uk-UA");
}
@functions {
    // РЕАЛЬНІ старти пар (як у твоїй таблиці)
    private static readonly TimeSpan[] PairStarts = new[]
    {
        new TimeSpan(9,  0, 0),  // 1: 09:00
        new TimeSpan(10, 10, 0), // 2: 10:10
        new TimeSpan(11, 20, 0), // 3: 11:20
        new TimeSpan(12, 30, 0), // 4: 12:30
        new TimeSpan(13, 40, 0), // 5: 13:40
        new TimeSpan(14, 50, 0), // 6: 14:50  (за потреби скоригуй)
        new TimeSpan(16,  0, 0), // 7: 16:00
        new TimeSpan(17, 10, 0), // 8: 17:10
    };

    // Нумерація по серединах між стартами
    private static int GetPairNumber(DateTime lessonStart)
    {
        var t = lessonStart.TimeOfDay;

        for (int i = 0; i < PairStarts.Length - 1; i++)
        {
            var mid = new TimeSpan((PairStarts[i].Ticks + PairStarts[i + 1].Ticks) / 2);
            if (t < mid) return i + 1; // пари з 1
        }
        return PairStarts.Length;
    }
}

<h2 class="mb-4">Розклад</h2>
<p class="text-muted">@Model.SelectedDate.ToString("dddd, dd MMMM yyyy", ukCulture)</p>
<div class="d-flex justify-content-between align-items-center mb-3">
    @if (isAdmin)
    {
        <form method="get" class="d-flex align-items-center">
            <select name="SelectedGroupId" class="form-select me-2" onchange="this.form.submit()">
                @foreach (var group in Model.AllGroups.OrderBy(g => g.Name))
                {
                    <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">@group.Name</option>
                }
            </select>
            <input type="hidden" name="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
        </form>
        <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#addLessonModal">➕ Додати заняття до розкладу</button>
        <!-- Кнопка-триггер модалки експорту -->
        <button class="btn btn-outline-dark mt-3" data-bs-toggle="modal" data-bs-target="#exportHoursModal">
            ⬇️ Витягнути години
        </button>
    }
</div>
<a class="btn btn-outline-dark" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@DateTime.Today.ToString("yyyy-MM-dd")">📅 Поточний тиждень</a>
<div class="d-flex justify-content-between mb-3">
    <div>
        <a class="btn btn-outline-secondary" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@Model.SelectedDate.AddDays(-7).ToString("yyyy-MM-dd")">◀️ Попередній тиждень</a>
        <a class="btn btn-outline-secondary" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@Model.SelectedDate.AddDays(7).ToString("yyyy-MM-dd")">▶️ Наступний тиждень</a>
    </div>
</div>
<div class="d-flex gap-2 mb-4">
    @foreach (var day in Model.WeekDays)
    {
        <a class="btn @(day == Model.SelectedDate ? "btn-dark" : "btn-outline-secondary")" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@day.ToString("yyyy-MM-dd")">@day.ToString("ddd dd")</a>
    }
</div>
<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Пара</th>
            <th>Час</th>
            <th>Предмет</th>
            <th>Тема</th>
            <th>Домашнє завдання</th>
            <th>Викладач</th>
            @if (isTeacher) { <th></th> }
        </tr>
    </thead>
    <tbody>

        @foreach (var lesson in Model.DayLessons.OrderBy(l => l.StartTime))
        {
            var start = lesson.StartTime;
            var end = start.Add(TimeSpan.FromMinutes(60));

            bool currentTeacherIsAdmin = isTeacher && Model.CurrentTeacher?.IsAdmin == true;
            bool isTodayLesson = lesson.StartTime.Date == DateTime.Today;
            bool topicOrHwEmpty = string.IsNullOrWhiteSpace(lesson.Topic) || string.IsNullOrWhiteSpace(lesson.Homework);
            <tr>
                <td>@GetPairNumber(lesson.StartTime)</td>
                <td>@start.ToString("HH:mm") - @end.ToString("HH:mm")</td>
                <td>
                    @{
                        if (isTeacher)
                        {
                            var gName = Model.AllGroups.FirstOrDefault(g => g.Id == lesson.GroupId)?.Name ?? "";
                            if (!string.IsNullOrWhiteSpace(gName))
                            {
                                @($"{lesson.Name} ({gName})")
                            }
                            else
                            {
                                @lesson.Name
                            }
                        }
                        else
                        {
                            @lesson.Name
                        }
                    }
                </td>

                <td>@lesson.Topic</td>
                <td>@lesson.Homework</td>
                <td>@Model._teacherNameCache.GetValueOrDefault(lesson.TeacherId, "—")</td>
                @if (isTeacher && lesson.TeacherId.ToString() == userId)
                {
                    <td>
                        <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editLessonModal"
                                data-lesson-id="@lesson.Id" data-lesson-topic="@lesson.Topic"
                                data-lesson-homework="@lesson.Homework" data-lesson-group="@lesson.GroupId"
                                data-lesson-date="@lesson.StartTime.ToString("yyyy-MM-ddTHH:mm")">
                            📝 Редагувати тему / ДЗ
                        </button>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
<!-- Модалка додавання заняття -->
<div class="modal fade" id="addLessonModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="AddLesson" />

                <div class="modal-header">
                    <h5 class="modal-title">➕ Додати заняття до розкладу</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="InputLesson.Id" />
                    <input type="hidden" name="InputLesson.GroupId" value="@Model.SelectedGroupId" />
                    <div class="mb-3">
                        <label class="form-label">Дата і час початку</label>
                        <input id="lessonStartTime" name="InputLesson.StartTime" type="datetime-local" class="form-control" required value="@selectedDateTime.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Назва предмету</label>
                            <select name="InputLesson.Name" class="form-select" required>
                                <option disabled selected value="">Оберіть предмет</option>
                                <option>Фізичне виховання</option>
                                <option>Основи екології</option>
                                <option>Основи правознавства</option>
                                <option>Вища математика</option>
                                <option>Опір матеріалів</option>
                                <option>Безпека життєдіяльності</option>
                                <option>ХІМІЯ</option>
                                <option>Інженерне креслення</option>
                                <option>Будівельне матеріалознавство</option>
                                <option>Інженерна геодезія</option>
                                <option>Електротехніка в будівництві</option>
                                <option>Будівельні конструкції</option>
                                <option>Фізичне виховання (заняття в секціях)***</option>
                                <option>Основи економічної теорії</option>
                                <option>Культурологія</option>
                                <option>Теоретична механіка</option>
                                <option>ФІЗИКА</option>
                                <option>Історія: Украiна і світ</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Викладач</label>
                            <select name="InputLesson.TeacherId" class="form-select" required>
                                <option disabled selected value="">Оберіть викладача</option>
                                @foreach (var teacher in Model.Teachers)
                                {
                                    <option value="@teacher.Id">@teacher.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Тема заняття</label>
                        <input name="InputLesson.Topic" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Домашнє завдання</label>
                        <textarea name="InputLesson.Homework" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">Зберегти</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Модалка імпорту -->
@if (isAdmin)
{
    <button class="btn btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#importLessonModal">📥 Імпортувати розклад з Excel</button>
}
<div class="modal fade" id="importLessonModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="ImportLessons" />

                <div class="modal-header">
                    <h5 class="modal-title">📥 Імпортувати розклад з Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="GroupId" value="@Model.SelectedGroupId" />
                    <div class="mb-3">
                        <label class="form-label">Оберіть Excel-файл розкладу</label>
                        <input type="file" name="File" class="form-control" accept=".xlsx" required />
                    </div>
                    <div class="mb-3">
                        <label for="isNumeratorSelect" class="form-label">Тип тижня для імпорту</label>
                        <select id="isNumeratorSelect" name="IsNumerator" class="form-select" required>
                            <option value="true" selected>Чисельник</option>
                            <option value="false">Знаменник</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">📤 Імпортувати</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Модалка редагування -->
<div class="modal fade" id="editLessonModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="EditLesson" />

                <div class="modal-header">
                    <h5 class="modal-title">📝 Додати тему / ДЗ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="InputLesson.Id" />
                    <input type="hidden" name="InputLesson.GroupId" />
                    <input type="hidden" name="InputLesson.StartTime" />
                    <div class="mb-3">
                        <label class="form-label">Тема заняття</label>
                        <input name="InputLesson.Topic" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Домашнє завдання</label>
                        <textarea name="InputLesson.Homework" class="form-control"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Кількість годин</label>
                        <textarea name="InputLesson.Clocks" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="exportHoursModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="handler" value="Export" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-semibold">Витягнути години</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    @* Викладач: для Teacher скрыто, для Admin — селект *@
                    @if (Model.Role == "Admin")
                    {
                        <div class="mb-3">
                            <label class="form-label">Викладач</label>
                            <select name="ExportFilters.TeacherId" class="form-select" required>
                                <option value="">Оберіть викладача</option>
                                @foreach (var t in Model.Teachers.OrderBy(x => x.FullName))
                                {
                                    <option value="@t.Id">@t.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    else if (Model.Role == "Teacher")
                    {
                        <input type="hidden" name="ExportFilters.TeacherId" value="@Model.CurrentTeacher?.Id" />
                    }

                    <div class="mb-3">
                        <label class="form-label">Предмет</label>
                        <select name="ExportFilters.SubjectName" class="form-select">
                            <option value="">Оберіть предмет</option>
                            <option>Фізичне виховання</option>
                            <option>Основи екології</option>
                            <option>Основи правознавства</option>
                            <option>Вища математика</option>
                            <option>Опір матеріалів</option>
                            <option>Безпека життєдіяльності</option>
                            <option>ХІМІЯ</option>
                            <option>Інженерне креслення</option>
                            <option>Будівельне матеріалознавство</option>
                            <option>Інженерна геодезія</option>
                            <option>Електротехніка в будівництві</option>
                            <option>Будівельні конструкції</option>
                            <option>Фізичне виховання (заняття в секціях)***</option>
                            <option>Основи економічної теорії</option>
                            <option>Культурологія</option>
                            <option>Теоретична механіка</option>
                            <option>ФІЗИКА</option>
                            <option>Історія: Украiна і світ</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Група</label>
                        <select name="ExportFilters.GroupId" class="form-select">
                            <option value="">Оберіть групу</option>
                            @foreach (var g in Model.AllGroups.OrderBy(x => x.Name))
                            {
                                <option value="@g.Id" @(g.Id == Model.SelectedGroupId ? "selected" : "")>@g.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата початку</label>
                        <input type="date" name="ExportFilters.StartDate" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата закінчення</label>
                        <input type="date" name="ExportFilters.EndDate" class="form-control" />
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-dark w-100 py-2">Витягнути файл</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const editModal = document.getElementById('editLessonModal');
            if (!editModal) return;
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;
                editModal.querySelector('input[name="InputLesson.Id"]').value = button.getAttribute('data-lesson-id');
                editModal.querySelector('input[name="InputLesson.GroupId"]').value = button.getAttribute('data-lesson-group');
                editModal.querySelector('input[name="InputLesson.StartTime"]').value = button.getAttribute('data-lesson-date');
                editModal.querySelector('input[name="InputLesson.Topic"]').value = button.getAttribute('data-lesson-topic') || "";
                editModal.querySelector('textarea[name="InputLesson.Homework"]').value = button.getAttribute('data-lesson-homework') || "";
            });
        });
    </script>
}
