@page
@model MyJournalApp.Pages.IndexModel
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Розклад";

    var isAdmin = Model.Role == "Admin";
    var isTeacher = Model.Role == "Teacher";
    var isStudent = Model.Role == "Student";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var selectedDateTime = Model.SelectedDate.ToDateTime(TimeOnly.FromDateTime(DateTime.Now));
}

<h2 class="mb-4">Розклад</h2>
@{
    var ukCulture = new CultureInfo("uk-UA");
}
<p class="text-muted">@Model.SelectedDate.ToString("dddd, dd MMMM yyyy", ukCulture)</p>

<div class="d-flex justify-content-between align-items-center mb-3">
    @if (isAdmin)
    {
        <form method="get" class="d-flex align-items-center">
            <select name="SelectedGroupId" class="form-select me-2" onchange="this.form.submit()">
                @foreach (var group in Model.AllGroups)
                {
                    <option value="@group.Id" selected="@(group.Id == Model.SelectedGroupId)">@group.Name</option>
                }
            </select>
            <input type="hidden" name="SelectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
        </form>
    }

    @if (isAdmin)
    {
        <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#addLessonModal">
            ➕ Додати заняття до розкладу
        </button>
    }
</div>
<a class="btn btn-outline-dark" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@DateTime.Today.ToString("yyyy-MM-dd")">
    📅 Поточний тиждень
</a>

<div class="d-flex justify-content-between mb-3">
    <div>
        <a class="btn btn-outline-secondary" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@Model.SelectedDate.AddDays(-7).ToString("yyyy-MM-dd")">
            ◀️ Попередній тиждень
        </a>
        <a class="btn btn-outline-secondary" href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@Model.SelectedDate.AddDays(7).ToString("yyyy-MM-dd")">
            ▶️ Наступний тиждень
        </a>
    </div>
</div>

<div class="d-flex gap-2 mb-4">
    @foreach (var day in Model.WeekDays)
    {
        <a class="btn @(day == Model.SelectedDate ? "btn-dark" : "btn-outline-secondary")"
           href="?SelectedGroupId=@Model.SelectedGroupId&SelectedDate=@day.ToString("yyyy-MM-dd")">
            @day.ToString("ddd dd")
        </a>
    }
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Пара</th>
            <th>Час</th>
            <th>Предмет</th>
            <th>Тема</th>
            <th>Домашнє завдання</th>
            <th>Викладач</th>
            @if (isTeacher)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @{
            int pairIndex = 1;
        }
        @foreach (var lesson in Model.DayLessons.OrderBy(l => l.StartTime))
        {
            var start = lesson.StartTime;
            var end = start.Add(TimeSpan.FromMinutes(90));
            <tr>
                <td>@pairIndex</td>
                <td>@start.ToString("HH:mm") - @end.ToString("HH:mm")</td>
                <td>@lesson.Name</td>
                <td>@lesson.Topic</td>
                <td>@lesson.Homework</td>
                <td>@Model._teacherNameCache.GetValueOrDefault(lesson.TeacherId, "—")</td>
                @{
                    // Получаем значение IsAdmin для текущего пользователя
                    bool currentTeacherIsAdmin = false;
                    if (isTeacher && Model.CurrentTeacher != null)
                    {
                        currentTeacherIsAdmin = Model.CurrentTeacher.IsAdmin;
                    }

                    bool isTodayLesson = lesson.StartTime.Date == DateTime.Today;
                    bool topicOrHwEmpty = string.IsNullOrWhiteSpace(lesson.Topic) || string.IsNullOrWhiteSpace(lesson.Homework);
                }

                @if (isTeacher
                            && lesson.TeacherId.ToString() == userId
                            && (
                            // Если админ-учитель — разрешаем на любых днях, где нет темы/ДЗ
                            (currentTeacherIsAdmin && topicOrHwEmpty)
                            // Если обычный учитель — только на сегодня
                            || (!currentTeacherIsAdmin && isTodayLesson && topicOrHwEmpty)
                            ))
                {
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#editLessonModal"
                                data-lesson-id="@lesson.Id"
                                data-lesson-topic="@lesson.Topic"
                                data-lesson-homework="@lesson.Homework"
                                data-lesson-group="@lesson.GroupId"
                                data-lesson-date="@lesson.StartTime.ToString("yyyy-MM-ddTHH:mm")">
                            📝 Додати тему / ДЗ
                        </button>
                    </td>
                }
                else if (isTeacher)
                {
                    <td></td>
                }
            </tr>
            pairIndex++;
        }
    </tbody>
</table>
<!-- 🧩 Модальне вікно для створення -->
<div class="modal fade" id="addLessonModal" tabindex="-1" aria-labelledby="lessonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">➕ Додати заняття до розкладу</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="InputLesson.Id" />
                    <input type="hidden" name="InputLesson.GroupId" value="@Model.SelectedGroupId" />
                    <div class="mb-3">
                        <label class="form-label">Дата і час початку</label>
                        <input id="lessonStartTime" name="InputLesson.StartTime" type="datetime-local" class="form-control" required value="@selectedDateTime.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    @if (isAdmin)
                    {
                        <div class="mb-3">
                            <label class="form-label">Назва предмету</label>
                            <select name="InputLesson.Name" class="form-select" required>
                                <option disabled selected value="">Оберіть предмет</option>
                                <option>Фізичне виховання</option>
                                <option>Основи екології</option>
                                <option>Основи правознавства</option>
                                <option>Вища математика</option>
                                <option>Опір матеріалів</option>
                                <option>Безпека життєдіяльності</option>
                                <option>ХІМІЯ</option>
                                <option>Інженерне креслення</option>
                                <option>Будівельне матеріалознавство</option>
                                <option>Інженерна геодезія</option>
                                <option>Електротехніка в будівництві</option>
                                <option>Будівельні конструкції</option>
                                <option>Фізичне виховання (заняття в секціях)***</option>
                                <option>Основи економічної теорії</option>
                                <option>Культурологія</option>
                                <option>Теоретична механіка</option>
                                <option>ФІЗИКА</option>
                                <option>Історія України</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Викладач</label>
                            <select name="InputLesson.TeacherId" class="form-select" required>
                                <option disabled selected value="">Оберіть викладача</option>
                                @foreach (var teacher in Model.Teachers)
                                {
                                    <option value="@teacher.Id">@teacher.FullName</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Тема заняття</label>
                        <input name="InputLesson.Topic" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Домашнє завдання</label>
                        <textarea name="InputLesson.Homework" class="form-control"></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-dark">Зберегти</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="importLessonModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" enctype="multipart/form-data" asp-page-handler="ImportLessons">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">📥 Імпортувати розклад з Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="GroupId" value="@Model.SelectedGroupId" />
                    <div class="mb-3">
                        <label class="form-label">Оберіть Excel-файл розкладу</label>
                        <input type="file" name="File" class="form-control" accept=".xlsx" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">📤 Імпортувати</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Кнопка для виклику модалки -->
@if (isAdmin)
{
    <button class="btn btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#importLessonModal">
        📥 Імпортувати розклад з Excel
    </button>
}
<!-- 🧩 Модальне вікно редагування теми / ДЗ -->
<div class="modal fade" id="editLessonModal" tabindex="-1" aria-labelledby="editLessonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">📝 Додати тему / ДЗ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="InputLesson.Id" />
                    <input type="hidden" name="InputLesson.GroupId" />
                    <input type="hidden" name="InputLesson.StartTime" />

                    <div class="mb-3">
                        <label class="form-label">Тема заняття</label>
                        <input name="InputLesson.Topic" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Домашнє завдання</label>
                        <textarea name="InputLesson.Homework" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Зберегти</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const editModal = document.getElementById('editLessonModal');
            if (!editModal) return;

            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                const id = button.getAttribute('data-lesson-id');
                const topic = button.getAttribute('data-lesson-topic') || "";
                const homework = button.getAttribute('data-lesson-homework') || "";
                const group = button.getAttribute('data-lesson-group');
                const date = button.getAttribute('data-lesson-date');

                // 👇 корректный выбор элементов внутри модалки
                editModal.querySelector('input[name="InputLesson.Id"]').value = id;
                editModal.querySelector('input[name="InputLesson.GroupId"]').value = group;
                editModal.querySelector('input[name="InputLesson.StartTime"]').value = date;
                editModal.querySelector('input[name="InputLesson.Topic"]').value = topic;
                editModal.querySelector('textarea[name="InputLesson.Homework"]').value = homework;
            });
        });
    </script>
}